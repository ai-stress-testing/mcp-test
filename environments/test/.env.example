# TEST environment — self-hosted Supabase on Docker.
#
# Copy to `.env` in this same folder (docker compose auto-loads a `.env`
# next to the compose file). `.env` must never be committed — only this
# `.env.example` is tracked. Every value below is a placeholder; there are
# no real secrets in this file.
#
# These are LOCAL/TEST-ONLY credentials for the throwaway Docker stack on
# your machine or CI runner. Never reuse a value from here in prod, and
# never copy a prod value in here.

# --- Postgres ---
POSTGRES_DB=postgres
# Any local string works — this Postgres is not reachable outside the
# Docker network except via the debug port below.
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

# --- Supabase platform auth ---
# Signing secret for the anon/service_role JWTs below. Generate locally:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-32-plus-char-local-secret

# Supabase API keys for THIS self-hosted stack — mint them locally from
# JWT_SECRET above (see environments/README.md "Minting local Supabase
# keys"). These are not real Supabase-hosted project keys and carry no
# access to anything outside your local containers.
SUPABASE_ANON_KEY=replace-with-locally-minted-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-locally-minted-service-role-jwt

# --- Gateway / URLs ---
KONG_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
STUDIO_PORT=3001

# PostgREST
PGRST_DB_SCHEMAS=public

# --- Stripe TEST MODE only (sk_test_ / pk_test_ / whsec_ prefixes) ---
# Get these from the Stripe dashboard in Test mode. A live-mode key here
# is a config error, not just a wrong value — the app should refuse to
# boot in APP_ENV=test with a pk_live_/sk_live_ key (backend-dev's seam).
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me

# --- App (consumed by the app image, not by this compose file) ---
APP_ENV=test
PRICE_FLOOR=replace-with-floor-cents
PRICE_CEIL=replace-with-ceiling-cents
