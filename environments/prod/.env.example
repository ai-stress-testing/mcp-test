# PRODUCTION environment — managed Supabase (or equivalent managed
# Postgres), per PRD sprint-7-26-19-26 §7.
#
# There is no docker-compose for prod: prod does not run the Supabase
# platform containers at all (db/auth/rest/studio/kong are the *test*
# stand-in for a managed service). The same app image that ran against
# the test stack is promoted unmodified and simply pointed at these vars
# instead — that's the whole parity contract.
#
# This file documents the *shape* of required config only. Every value is
# a placeholder. Real values are injected by the deploy platform's secret
# manager at deploy/runtime (e.g. host env vars, a secrets store) — never
# written to a file on the prod host, never committed here.

# --- Supabase (managed project) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-with-managed-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-managed-project-service-role-key
# Direct/pooled Postgres connection for the offline learner cron
# (ADR-0001) and migrations — from the managed project's connection
# settings, not hand-built.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres

# --- Stripe LIVE mode only (sk_live_ / pk_live_ / whsec_ prefixes) ---
# A test-mode key here is a config error — same guard as the test env,
# inverted (backend-dev's seam: refuse to boot in APP_ENV=prod with a
# pk_test_/sk_test_ key).
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_live_replace_me

# --- App ---
APP_ENV=prod
SITE_URL=https://<your-production-domain>
PRICE_FLOOR=replace-with-floor-cents
PRICE_CEIL=replace-with-ceiling-cents

# --- Owner analytics dashboard (MT-29) ---
# Single-owner gate for /admin/* — "only the operator sees data".
# OWNER_PASSCODE: the login passcode (set a long random value; never commit the real one)
# OWNER_SESSION_SECRET: HMAC key that signs the owner session cookie (rotate to log everyone out)
OWNER_PASSCODE=change-me-to-a-long-random-passcode
OWNER_SESSION_SECRET=change-me-to-a-long-random-secret
